#!/bin/sh

if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: `basename "$0"` <target_image> <image_body>" >&2
    echo >&2
    echo "Patch target image, replacing its body with the provided one" >&2
    echo >&2
    echo "Hint: run gs_imgtool -u first" >&2
    exit 1
fi

# make sure the files are there
if [ ! -e "$1" ]; then
    echo "$1: file not found!"
    exit 1
fi
if [ ! -e "$2" ]; then
    echo "$2: file not found!"
    exit 1
fi

# extract the header
IMG_HEADER=`gs_imgtool -qHn "$1"` || exit 1

# concatenate together
cat "$IMG_HEADER" "$2" > "$1"

# fix header
gs_imgtool -qf "$1" || exit 1

# clean up
rm "$IMG_HEADER"