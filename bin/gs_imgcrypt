#!/usr/bin/env node

import fs from "fs/promises";
import process from "process";

import { program } from "commander";

import { gsCipher, gsSwapBytes, MAGIC } from "../lib/crypto.js";

program
    .description("HT818 image encryption utility")
    .option("-o, --output <filename>", "write to new file instead of overwriting")
    .option("-e, --encrypt", "encrypt instead of decrypting")
    .argument("<input>")
    .parse();
const options = program.opts();
const input = program.args[0];

const file = await fs.readFile(input);
const header = file.subarray(0, 0x4000);

function sanity(assertion, should) {
    if (assertion) {
        console.error(`\x1b[31msanity check failed: ${should}\x1b[0m`);
        process.exit(1);
    }
}

if (options.encrypt) {
    // check magic
    sanity(header.readUint32LE(0) !== MAGIC, "file header magic is invalid\n\nis the file already encrypted?");

    // get body key
    const key = gsSwapBytes(header.subarray(0x10, 0x20));

    // encrypt body
    const body = file.subarray(0x4000);
    gsCipher(body, true, key);

    // encrypt header
    gsCipher(header, true);
}
else {
    // make sure magic isnt already there
    sanity(header.readUint32LE(0) === MAGIC, "file header magic is already valid\n\nis the file already decrypted?");

    // decrypt header
    gsCipher(header);

    // check magic
    sanity(header.readUint32LE(0) !== MAGIC, "file header magic is invalid after decryption");

    // get body key
    const key = gsSwapBytes(header.subarray(0x10, 0x20));

    // decrypt body
    const body = file.subarray(0x4000);
    gsCipher(body, false, key);
}

await fs.writeFile(options.output ?? input, file);